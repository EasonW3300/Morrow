# Morrow Runtime 环境文件（systemd EnvironmentFile 格式；安装到 /etc/morrow/morrow.env）
#
# 语法：KEY=VALUE，一行一个；`#` 开头的行是注释。不要使用 `export`，也不要把变量写成
# 空值（例如 `MORROW_REPLICA_ID=` 会被当作空字符串并触发校验失败——要么注释掉，要么写值）。
# 修改后：sudo systemctl restart morrow

# --- 监听（ADR-0004：默认只监听回环，绝不监听公网）--------------------------------
# 纯本地/桌面 sidecar 用 127.0.0.1。服务器形态要与其它设备同步时，改成**私有网络接口
# 地址**，推荐 Tailscale：`tailscale ip -4`（形如 100.x.y.z），或 WireGuard 的 wg0 地址。
# 不要使用 0.0.0.0 / ::（会同时监听所有网卡，包括公网网卡）。
# 非回环访问必须携带配对下发的 bearer token（ADR-0008）：回环豁免，其余来源无 token
# 一律 401；配对流程见 deploy/README.md「混合形态」。
MORROW_HOST=127.0.0.1
MORROW_PORT=8787

# --- 数据目录（账本、记忆投影、设备/同步游标、workspace 全部在此）------------------
# 约定路径；systemd unit 的 StateDirectory 也指向这里，安装脚本会建好并 chown morrow。
MORROW_DATA_DIR=/var/lib/morrow

# 副本身份（uuid，小写）。留空/注释 = 首次启动在 <DATA_DIR>/replica-id 生成并持久化。
# 迁移机器时保留 dataDir 即保留身份；显式固定（例如从备份恢复）时取消注释：
# MORROW_REPLICA_ID=00000000-0000-4000-8000-000000000000

# --- Provider（OpenAI 兼容；不配置也能启动，但发消息会 503）------------------------
# 三个变量同时出现才生效：BASE_URL 与 MODEL 必填，API_KEY 可空（vLLM/Ollama 等本地端点）。
# MORROW_PROVIDER_BASE_URL=http://100.64.0.2:11434/v1
# MORROW_PROVIDER_API_KEY=
# MORROW_PROVIDER_MODEL=qwen3:8b
# MORROW_PROVIDER_CONTEXT_WINDOW=131072
# MORROW_PROVIDER_MAX_TOKENS=8192

# 后台记忆抽取器：heuristic（默认，零网络）| llm（需要上面的 Provider 可解析）
# MORROW_MEMORY_EXTRACTOR=heuristic

# --- Owner 的平台身份（渠道入站必需）---------------------------------------------
# 渠道消息必须能映射到已知身份：映射到 owner 按主人处理，映射到可信联系人按授权处理；
# 没有映射的一律 inbound_rejected(unknown_sender) 丢弃——这是防冒充的正确默认。但**必须**
# 声明"哪个平台 id 是我"，否则你自己在 QQ/飞书里发消息也会被拒。
#
# 取值：QQ 是 member_openid（32 位十六进制），飞书是 ou_ 开头 open_id，逗号分隔可多个。
# 不知道自己的 id？先在渠道里发一条，账本会出现 channel.inbound_rejected 且 payload
# 带 sender_native_id，复制到下面即可。
# MORROW_OWNER_QQ_IDS=FBE72705F609C036A8E7C3D59970721D
# MORROW_OWNER_FEISHU_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MORROW_OWNER_WECHAT_IDS=wxid_xxxx

# 设备密钥后端：auto（默认，macOS Keychain / Windows 凭据管理器 / Linux secret-tool）
# 生产部署不要改成 memory——它只把私钥放进程内存，供冒烟/CI 使用。
MORROW_SECRET_BACKEND=auto
