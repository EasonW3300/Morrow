{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morrow",
  "version": "0.1.0",
  "identifier": "app.morrow.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @morrow/runtime build && pnpm --filter @morrow/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm -r build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Morrow",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../runtime/dist/main.js": "runtime/main.js"
    },
    "macOS": {
      "signingIdentity": null
    }
  }
}
