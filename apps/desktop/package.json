{
  "name": "@morrow/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri 2 + React 桌面壳（票 T6 / Issue #7）：sidecar 拉起 Runtime，Chat 视图经控制面 HTTP/SSE 通信",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && node --experimental-strip-types --test \"src/*.test.ts\" && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@morrow/protocol": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
