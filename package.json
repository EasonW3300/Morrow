{
  "name": "morrow",
  "private": true,
  "version": "0.1.0",
  "description": "单主人、长期记忆、可自主生成能力的个人 Agent",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "pack:runtime": "pnpm --filter @morrow/packaging binary",
    "probe:runtime:standalone": "pnpm --filter @morrow/packaging probe:standalone",
    "probe:runtime:sidecar": "pnpm --filter @morrow/packaging probe:sidecar",
    "probe:runtime": "pnpm run probe:runtime:standalone && pnpm run probe:runtime:sidecar",
    "gate:runtime": "node --experimental-strip-types scripts/packaging/src/gate.ts"
  }
}
